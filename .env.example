# Dashboard server
PORT=3000
CLIENT_ORIGIN=http://localhost:3000

# Optional durable auth/database configuration.
# For Supabase, use the pooled PostgreSQL connection string from the Connect dialog.
DATABASE_URL=
JWT_SECRET=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=

# Frontend build-time API base. Leave empty when frontend and backend share an origin.
VITE_API_BASE_URL=
# Public Supabase client configuration for the login page. Never use a service-role key here.
VITE_SUPABASE_URL=https://zngqkjdrmowohftogbrn.supabase.co
VITE_SUPABASE_ANON_KEY=
# Frontend OAuth portal configuration. Required for the login screen's secure sign-in button.
VITE_OAUTH_PORTAL_URL=
VITE_APP_ID=

# Local preview only. Never enable demo auth in a production deployment.
DEMO_AUTH_ENABLED=false
DEMO_AUTH_EMAIL=demo@fraudsentinel.local
DEMO_AUTH_PASSWORD=SentinelDemo123!
