{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": "vite",
  "buildCommand": "pnpm exec vite build",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": "dist/public",
  "rewrites": [
    { "source": "/fastapi/:path*", "destination": "/api/fastapi" },
    { "source": "/api/fastapi/:path*", "destination": "/api/fastapi" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/fastapi.py": {
      "maxDuration": 30,
      "excludeFiles": "{node_modules/**,client/**,server/**,dist/**,datasets/**,data/**,tests/**,.git/**,.env*,.venv/**,.npm/**,tmp/**,outputs/**,monitoring/**,mlops/**}"
    },
    "api/index.ts": {
      "maxDuration": 30,
      "includeFiles": "{datasets/**,data/reputation/**}"
    }
  }
}
